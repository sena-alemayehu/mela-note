# ==============================================================================
# Mela Note - Environment Configuration Template
# Copy this file to .env and replace with your secure secrets before starting
# ==============================================================================

# Domain for VPS Automated HTTPS (e.g., notes.yourcompany.com or localhost for local testing)
DOMAIN=localhost

# Database Configuration (MySQL 8.4)
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password
MYSQL_DATABASE=mela_note
MYSQL_USER=mela_app
MYSQL_PASSWORD=change_this_to_a_strong_app_password

# Backend Configuration
PORT=3001
NODE_ENV=production
DATABASE_URL=mysql://mela_app:change_this_to_a_strong_app_password@db:3306/mela_note
JWT_SECRET=change_this_to_a_random_32_character_secret_key_minimum_length
FRONTEND_URL=https://localhost

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api
